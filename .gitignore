# Local environment configurations (contains secrets/passwords)
.env
.env.*
!.env_example

# AWS credentials — NEVER commit these
.aws/
*.pem
*.p12

# Terraform state & secrets — NEVER commit
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
*.tfvars
!*.tfvars.example
.terraform.lock.hcl
crash.log
crash.*.log

# Python virtual environments & caching
venv/
.venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/

# Node/Vite packages and production build outputs
node_modules/
dist/
build/
.eslintcache

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
