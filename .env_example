# ==============================================================================
# SaaS HR Multi-Tenant: Environment Variables Template File (.env_example)
# Copy this file to '.env' at the root of the project to run the system.
# ==============================================================================

# 1. MySQL Database root configurations
# Note: Port 3307 is mapped on the host machine to avoid conflict with local MySQL (3306)
MYSQL_ROOT_PASSWORD=strongpassword123
MYSQL_HOST=localhost
MYSQL_PORT=3307

# 2. Database connection strings for individual microservices
# Note: For running services locally on Windows host, use port 3307.
DATABASE_TENANT_URL=mysql+pymysql://root:strongpassword123@localhost:3307/tenant_db
DATABASE_AUTH_URL=mysql+pymysql://root:strongpassword123@localhost:3307/auth_db
DATABASE_HR_URL=mysql+pymysql://root:strongpassword123@localhost:3307/hr_db

# 3. Security & JWT Asymmetric Cryptography configurations (RS256)
JWT_ALGORITHM=RS256

